{
  "name": "@cycjimmy/hello-github-package-npm",
  "type": "module",
  "version": "8.0.0",
  "description": "hello github package npm",
  "browser": "dist/hello-world.umd.min.js",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/hello-github-package-npm#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/cycjimmy/hello-github-package-npm.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/hello-github-package-npm/issues"
  },
  "keywords": [
    "github",
    "package",
    "npm"
  ],
  "exports": {
    "import": "./dist/hello-world.esm.js",
    "default": "./dist/hello-world.esm.js"
  },
  "main": "dist/hello-world.esm.js",
  "module": "dist/hello-world.esm.js",
  "scripts": {
    "start": "npm run dev",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --color --forceExit --detectOpenHandles",
    "coveralls": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --color --forceExit --detectOpenHandles --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "dev": "vite",
    "build": "trash dist && npm run build:esm && npm run build:umd && npm run build:umd:min",
    "build:esm": "vite build --mode esm",
    "build:umd": "vite build --mode umd",
    "build:umd:min": "vite build --mode umd-min",
    "build:deployment": "vite build --mode deployment && node tasks/copyPublishFiles.js",
    "package": "trash .release && npm run build && node tasks/copyFiles.js && node tasks/handlePackageJson.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cycjimmy/sass-lib": "^4.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@babel/core": "^7.24.9",
    "@babel/preset-env": "^7.24.8",
    "@cycjimmy/config-lib": "^3.2.1",
    "autoprefixer": "^10.4.19",
    "babel-jest": "^30.4.1",
    "coveralls": "^3.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "fs-extra": "^11.2.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.3.0",
    "sass": "^1.106.0",
    "terser": "^5.51.2",
    "trash-cli": "^7.2.0",
    "vite": "^8.3.5"
  }
}
